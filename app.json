{
  "expo": {
    "name": "PearLift",
    "slug": "PearLift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pearlift_icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/pearlift_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111113"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "bundleIdentifier": "dev.okazakee.pearlift"
    },
    "android": {
      "package": "dev.okazakee.pearlift",
      "adaptiveIcon": {
        "foregroundImage": "./assets/pearlift_splash.png",
        "backgroundColor": "#111113"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow PearLift to use Face ID to confirm sensitive actions."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn expo.modules.core.interfaces.services.KeepAwakeManager"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-localization"
    ]
  }
}
