{
  "expo": {
    "name": "PearLift",
    "slug": "PearLift",
    "version": "1.0.8",
    "orientation": "default",
    "icon": "./assets/pearlift_icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "dev.okazakee.pearlift",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/pearlift_splash.png",
        "backgroundColor": "#111113"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow PearLift to use Face ID to confirm sensitive actions."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "usePrecompiledHeaders": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.margelo.nitro.camera.** { *; }\n-keep class com.margelo.nitro.image.** { *; }\n-keep class com.margelo.nitro.core.** { *; }\n-keep class com.margelo.nitro.NitroModules { *; }\n-dontwarn expo.modules.core.interfaces.services.KeepAwakeManager"
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "./plugins/withSyncBackendBundle",
      "./plugins/with-optional-release-signing",
      "./plugins/with-pearlift-abi-splits",
      "expo-font",
      [
        "expo-status-bar",
        {
          "style": "auto",
          "hidden": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/pearlift_splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111113"
        }
      ],
      "expo-image"
    ],
    "ios": {
      "bundleIdentifier": "dev.okazakee.pearlift"
    }
  }
}
