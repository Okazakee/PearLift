{
  "name": "pearlift",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:debug": "expo run:android",
    "android:logs": "adb logcat | rg \"PearLift|ReactNativeJS|expo-file-system|StorageAccessFramework|DocumentPicker\"",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bundle:sync-backend": "bare-pack --host ios --host android --linked --out src/sync/sync.bundle.mjs backend/sync-backend.mjs",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "postinstall": "node ./scripts/ensure-bun-expo-doctor-dedupe.mjs && node ./scripts/apply-node-modules-patches.mjs",
    "prepare": "husky",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "check:full": "bun run lint && bun run typecheck",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "autobase": "^7.27.3",
    "b4a": "^1.8.0",
    "bare-fs": "^4.7.1",
    "bare-rpc": "^1.2.0",
    "corestore": "^7.9.2",
    "expo": "^55.0.0",
    "expo-av": "^16.0.8",
    "expo-build-properties": "^55.0.13",
    "expo-camera": "^55.0.16",
    "expo-clipboard": "~55.0.13",
    "expo-crypto": "~55.0.14",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.16",
    "expo-font": "^55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-keep-awake": "^55.0.6",
    "expo-local-authentication": "^55.0.13",
    "expo-localization": "~55.0.13",
    "expo-notifications": "~55.0.19",
    "expo-secure-store": "~55.0.13",
    "expo-sharing": "~55.0.18",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "^55.0.15",
    "graceful-goodbye": "^1.3.3",
    "hyperswarm": "^4.17.0",
    "i18next": "^26.0.6",
    "lucide-react-native": "^1.8.0",
    "pearlift-rest-timer-fgs": "file:./modules/pearlift-rest-timer-fgs",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-i18next": "^17.0.4",
    "react-native": "0.83.4",
    "react-native-bare-kit": "^0.13.3",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-sortables": "^1.9.4",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "^0.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/b4a": "^1.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.10",
    "bare-pack": "^2.0.1",
    "husky": "^9.1.7",
    "typescript": "~5.9.2"
  },
  "private": true
}
