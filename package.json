{
  "name": "pearlift",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:debug": "expo run:android",
    "android:logs": "adb logcat | rg \"PearLift|ReactNativeJS|expo-file-system|StorageAccessFramework|DocumentPicker\"",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android",
    "postinstall": "node ./scripts/ensure-bun-expo-doctor-dedupe.mjs && node ./scripts/apply-node-modules-patches.mjs",
    "prepare": "husky",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "check:full": "bun run lint && bun run typecheck",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@scure/base": "^2.0.0",
    "expo": "^55.0.0",
    "expo-av": "^16.0.8",
    "expo-build-properties": "~55.0.13",
    "expo-crypto": "~55.0.14",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.16",
    "expo-font": "^55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-keep-awake": "^55.0.6",
    "expo-local-authentication": "^55.0.13",
    "expo-notifications": "~55.0.19",
    "expo-secure-store": "~55.0.13",
    "expo-sharing": "~55.0.18",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "^55.0.15",
    "lucide-react-native": "^1.8.0",
    "pearlift-rest-timer-fgs": "file:./modules/pearlift-rest-timer-fgs",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-draggable-flatlist": "^4.0.2",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "^0.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/react": "~19.2.10",
    "husky": "^9.1.7",
    "typescript": "~5.9.2"
  },
  "private": true
}
