{
  "name": "pearlift",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:debug": "expo run:android",
    "android:logs": "adb logcat | rg \"PearLift|ReactNativeJS|expo-file-system|StorageAccessFramework|DocumentPicker\"",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android",
    "prepare": "husky",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "check:full": "bun run lint && bun run typecheck",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.33",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/react": "~19.1.0",
    "husky": "^9.1.7",
    "typescript": "~5.9.2"
  },
  "private": true
}
